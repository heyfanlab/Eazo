# Openai兼容格式
LLM_BASE_URL=https://xxx.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
CHAT_MODEL=qwen-plus-2025-07-28
VISION_MODEL=qwen-vl-max
EMBED_MODEL=text-embedding-v4
# Vercel requires a persistent PostgreSQL database (injected by the Neon integration).
# DATABASE_URL=postgresql://...
# Use real Shanghai time on the public deployment; local demos can set true.
DEMO_MODE=false
APP_TIMEZONE=Asia/Shanghai
